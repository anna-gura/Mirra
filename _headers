# Security headers.
#
# Read by Cloudflare and applied to every response. Kept in the
# repository rather than clicked into a dashboard so that the rules are
# reviewable, diffable, and survive a project being recreated.
#
# The rule for this file: every origin listed must have a reason, and
# the reason is written below. Anything that cannot be justified is
# removed, even if removing it risks finding out the hard way that it
# was needed — a policy nobody can account for drifts wider every year
# until it protects nothing.
#
# ---------------------------------------------------------------
# What the policy allows, and why
#
#   script-src  accounts.google.com    the sign-in library
#               apis.google.com        the file picker
#   connect-src *.googleapis.com       reading and writing the sheet
#               accounts.google.com    obtaining and renewing tokens
#               oauth2.googleapis.com  revoking them on sign-out
#   frame-src   'self'                 the bridge the picker talks through,
#                                      which is a frame onto this domain
#               accounts.google.com    the sign-in window
#               docs.google.com        the picker itself, which is a frame
#               drive.google.com       listed by Google's own documentation
#               content.googleapis.com an older picker endpoint
#   img-src     *.googleusercontent.com  the account's own avatar
#
# Fonts, styles, workers and the manifest are all 'self': the font files
# live in assets/fonts precisely so that no other origin is needed.
#
# ---------------------------------------------------------------
# Removed, then put back
#
# These three were taken out on the grounds that nothing proved they
# were needed. The picker then stopped opening on the live site, which
# is the proof, so they are back:
#
#   script-src  https://www.gstatic.com         helper files for the picker
#   img-src     https://*.gstatic.com           picker icons
#   frame-src   https://content.googleapis.com  an older picker endpoint
#
# All three are Google's own origins, already trusted for the sign-in
# that cannot be removed either. The lesson kept: remove on evidence,
# not on suspicion — and restore the same way.
#
# ---------------------------------------------------------------
# The one inline style, and why it is named rather than allowed
#
# Google's picker is built, loaded, and then shown by setting a style on
# it directly. With style-src 'self' that last step was refused, so the
# window existed and stayed invisible — which looks exactly like loading
# that never finishes, and reports nothing, because nothing failed.
#
# Report-only mode named the offender: one style, one fingerprint. So
# that single style is allowed by its hash instead of opening the door
# to inline styles in general. Any other style, including one injected
# by an attacker, still does not match and is still refused.
#
# 'unsafe-hashes' is what lets a hash apply to a style attribute rather
# than a <style> block. Its name is alarming and its effect here is not:
# without a matching hash it permits nothing.
#
# If the picker misbehaves again, report-only will name the next hash.
# Add it beside this one rather than reaching for 'unsafe-inline'.
#
# ---------------------------------------------------------------
# Considered and not used
#
#   require-trusted-types-for 'script'
#     Stricter still, and it would break Google's own libraries, which
#     build markup the way this app deliberately does not.
#
#   Cross-Origin-Embedder-Policy
#     Would block those libraries outright.
#
#   HSTS preload
#     A one-way door: browsers ship the list baked in, and removal takes
#     months. Worth adding once the domain has settled.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://accounts.google.com https://apis.google.com https://www.gstatic.com; style-src 'self' 'unsafe-hashes' 'sha256-O5RJqRuy+/mksltO9mWs9LuNKQs/41ZS8QoMC9SP/Fg='; img-src 'self' data: https://*.googleusercontent.com https://*.gstatic.com; font-src 'self'; connect-src 'self' https://*.googleapis.com https://accounts.google.com https://oauth2.googleapis.com; frame-src 'self' https://accounts.google.com https://docs.google.com https://drive.google.com https://content.googleapis.com; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests

  # HTTPS only, for a year, including any subdomain.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # A file served as text/plain stays text/plain, whatever it contains.
  X-Content-Type-Options: nosniff

  # frame-ancestors above is the modern rule; this is for browsers that
  # never learned it. Mirra is never framed by anybody, including us.
  X-Frame-Options: DENY

  # The origin travels to other sites, the path never does. Not
  # "no-referrer", which would be stricter and would break the API key:
  # Google checks the referring origin before honouring it, and a key
  # with no such check is a key anybody can borrow.
  Referrer-Policy: strict-origin-when-cross-origin

  # Hardware and ambient APIs Mirra does not use and must not acquire by
  # accident. An empty list denies the page and everything it frames.
  Permissions-Policy: accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), idle-detection=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()

  # Our own files cannot be pulled into another site's page.
  Cross-Origin-Resource-Policy: same-origin

  # Isolates this window from anything it opens, except the popup Google
  # signs people in with — "same-origin" alone severs that connection and
  # sign-in stops working.
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# ---------------------------------------------------------------
# The one exception, and why it exists
#
# Google's file picker opens in a window of its own and talks back to
# Mirra through a bridge: it loads a file from this domain inside its
# own page, and uses it to pass messages across. The rule above forbids
# framing anything from here, so the bridge never forms and the picker
# loads for ever.
#
# The exception is as small as it can be made: one file, framed by this
# site and by Google. favicon.ico is an image — no data, no code, no
# access to anything. Everything else on the domain stays under a flat
# refusal.
#
# 'self' belongs here as much as Google does: the bridge is a frame that
# Mirra's own page opens onto Mirra's own domain, and frame-ancestors
# 'none' refuses even that.
#
# The two "!" lines remove the headers set above for this path only;
# without them Cloudflare sends both, and a browser given two policies
# obeys the stricter — which is the one being worked around.
/favicon.ico
  ! X-Frame-Options
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; frame-ancestors 'self' https://docs.google.com https://drive.google.com https://accounts.google.com https://apis.google.com https://content.googleapis.com
  Cross-Origin-Resource-Policy: cross-origin

# The service worker controls every page, so a stale one is worse than a
# slow one.
/sw.js
  Cache-Control: no-cache

/js/version.js
  Cache-Control: no-cache

/version.json
  Cache-Control: no-cache

# Font files never change without changing name, so they can be kept for
# a year. Nothing here is personal: the same four files for everybody.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
